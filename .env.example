# Copy to .env.local inside memorygram-mobile. Both values are public app configuration.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public HTTPS URL of the Memorygram service for live SF listings and suggestions.
EXPO_PUBLIC_SERVICE_URL=

# Optional HTTPS origin serving the Expo web app, for shareable browser links.
EXPO_PUBLIC_APP_ORIGIN=
